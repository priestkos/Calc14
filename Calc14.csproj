<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.1</Version>
    <Description>A snappy calculator with history, percentage and clear modes.</Description>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Calc14.Tests/**" />
  </ItemGroup>
  <PropertyGroup>
    <Author>PriestKos</Author>
    <Authors>PriestKos</Authors>
    <Name>Calc14</Name>
    <Punchline>A fast, pretty calculator for FFXIV.</Punchline>
    <RepoUrl>https://github.com/priestkos/Calc14</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/priestkos/Calc14/main/images/icon.png</IconUrl>
    <Tags>calculator;utility</Tags>
  </PropertyGroup>
</Project>
