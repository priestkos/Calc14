<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Description>A snappy calculator with history, percentage and clear modes.</Description>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <Author>saijm</Author>
    <Name>CalculatorXIV</Name>
    <Punchline>A fast, pretty calculator for FFXIV.</Punchline>
    <RepoUrl>https://github.com/priestkos/CalculatorXIV</RepoUrl>
    <Tags>utility</Tags>
  </PropertyGroup>
</Project>
